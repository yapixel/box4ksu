{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "output": "sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": false
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9090",
      "external_ui": "zashboard",
      "external_ui_download_url": "https://github.com/ruaue/zashboard/releases/download/v3.21.0/dist-no-fonts.zip",
      "access_control_allow_origin": [
        "http://127.0.0.1",
        "https://zash.zend.eu.org"
      ],
      "access_control_allow_private_network": true,
      "external_ui_download_detour": "Proxy"
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9080,
      "secret": "",
      "access_control_allow_origin": [
        "http://127.0.0.1",
        "https://dashboard.zend.eu.org",
        "https://zash.zend.eu.org"
      ],
      "access_control_allow_private_network": true,
      "dashboard": {
        "enabled": true,
        "path": "/dist",
        "download_url": "",
        "http_client": "detour_proxy",
        "update_interval": "24h"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "detour_proxy",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "ali",
          "tencent"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ]
        }
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "direct",
          "geosite/apple-cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "geosite/category-ads-all"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite/category-ai-!cn",
          "geosite/google"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "geosite/cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite/geolocation-!cn"
        ],
        "action": "route",
        "server": "dns-proxy"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7080
    },
    {
      "type": "ebpf",
      "tag": "ebpf-in",
      "mode": "hybrid",
      "bypass_rule_set": [
        "geoip/cn"
      ],
      "local": {
        "dns_mode": "respect_policy",
        "ipv6_mode": "auto",
        "include_package": [],
        "exclude_package": []
      },
      "shared": {
        "dns_mode": "respect_policy",
        "interface": [
          "wlan2"
        ],
        "ipv6_mode": "always"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "direct"
      ],
      "default": "direct",
      "use_all_providers": true,
      "interrupt_exist_connections": true
    }
  ],
  "outbound_providers": [
    {
      "tag": "Provider1",
      "type": "remote",
      "url": "url",
      "exclude": "节点|剩余|套餐|客服|官网",
      "path": "./source/Provider1.json",
      "update_interval": "24h",
      "user_agent": "clash.meta/alpha/mihomo",
      "health_check": {
        "enabled": true,
        "url": "http://cp.cloudflare.com/generate_204",
        "interval": "30m",
        "timeout": "3s"
      }
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      {
        "type": "local",
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "format": "source",
        "path": "./source/{tag}.json"
      },
      {
        "type": "remote",
        "tag": "Ads_AWAvenue",
        "format": "source",
        "url": "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Singbox.json",
        "update_interval": "24h",
        "path": "./source/rule_set/Ads_AWAvenue.json"
      },
      {
        "type": "remote",
        "tag": [
          "geosite/category-ads-all",
          "geosite/apple-cn",
          "geosite/category-ai-!cn",
          "geosite/google",
          "geosite/geolocation-!cn",
          "geosite/cn",
          "geoip/cn",
          "geoip/telegram"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{tag}.srs",
        "update_interval": "24h",
        "path": "./source/rule_set/{tag}.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "geosite/category-ads-all"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite/category-ai-!cn",
          "geosite/google"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "geosite/apple-cn",
          "geosite/cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite/geolocation-!cn"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "rule_set": "geoip/cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geoip/telegram"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Proxy"
  }
}