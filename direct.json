            ".ele.me",
            ".aikeu.com"
          ],
          "domain": [
            "aikeu.com",
            "ele.me"
          ],
          "domain_keyword": [
            "ntp"
          ],
          "domain_regex": [
            "(^|\\.)(alt[1-8]-mtalk|mtalk|mtalk4|mtalk-dev|mtalk-staging)\\.google\\.com$"
          ]
        },
        {
          "ip_cidr": [
            "2.2.2.2/32"
          ]
        },
        {
